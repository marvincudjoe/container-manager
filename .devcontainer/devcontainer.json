{
  "name": "Java",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installGradle": "true",
      "gradleVersion": "8.8"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "jetbrains": {
      "extensions": [
        "google-java-format",
        "com.github.copilot"
      ]
    },
    "settings": {
    },
    "backend": "IntelliJ"
  },
  "postCreateCommand": "java -version",
}
